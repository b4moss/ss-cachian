{
  "name": "@b4moss/ss-cachian",
  "version": "0.9.0",
  "description": "Server-side cache strategy library (TypeScript/JavaScript). Config-driven Cache Types (v0.9.0) with Go parity.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.d.ts.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "rm -rf dist && npm run build && node --test 'dist/**/*.test.js'",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b4moss/ss-cachian.git",
    "directory": "node/sscachian"
  },
  "bugs": {
    "url": "https://github.com/b4moss/ss-cachian/issues"
  },
  "homepage": "https://github.com/b4moss/ss-cachian#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cache",
    "ss-cachian",
    "versioned-cache"
  ],
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.6",
    "yaml": "^2.7.0"
  }
}
